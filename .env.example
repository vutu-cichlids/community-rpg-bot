# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (Client) ID of your Discord application
DISCORD_CLIENT_ID=

# Optional: set to a guild (server) ID during development for instant slash-command
# registration in that one server. Leave empty in production for global commands
# (global registration can take up to ~1 hour to propagate).
DISCORD_DEV_GUILD_ID=

# PostgreSQL connection string. On Railway, add a PostgreSQL plugin to the project
# and it will provide this value automatically (reference it as ${{Postgres.DATABASE_URL}}
# in the bot service's variables, or copy the value directly).
DATABASE_URL=postgresql://user:password@host:5432/database
